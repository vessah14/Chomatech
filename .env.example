# Réglages Docker de CHOMA TECH. Copier ce fichier en ".env" (même dossier) puis l'adapter.
# Toutes les valeurs ont un équivalent par défaut dans docker-compose.yml : sans .env, le projet
# démarre quand même avec des valeurs de développement local.
# ⚠️ Le fichier .env n'est jamais versionné (.gitignore) : il peut contenir des secrets.

# --- Ports sur votre machine ---
SITE_PORT=5173
ADMIN_PORT=5174
DB_PORT=5433

# --- Base de données (conteneur) ---
POSTGRES_DB=chomatech
POSTGRES_USER=chomatech
POSTGRES_PASSWORD=chomatech-dev

# --- Sécurité ---
# Clé de signature des sessions : 32 caractères minimum, aléatoire, différente par environnement.
# Exemple pour en générer une (PowerShell) : [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_KEY=dev-uniquement-cle-locale-a-remplacer-0123456789abcdef

# Premier compte administrateur, créé au démarrage si la base n'a encore aucun admin.
# Changez le mot de passe après la première connexion (Paramètres du site client).
ADMIN_EMAIL=admin@chomatech.local
ADMIN_PASSWORD=Admin-Chomatech-2026

# --- Paiements SasPay (vide = paiement désactivé) ---
SASPAY_BASE_URL=https://api.saspay.me/api/v1/
SASPAY_API_KEY=
SASPAY_COUNTRY=CM
SASPAY_CURRENCY=XAF
SASPAY_WEBHOOK_SECRET=

# URL publique du site client ; en production, remplacer par https://chomatech.cm
SITE_URL=http://localhost:5173

# --- Facultatif : emails via Brevo (mot de passe oublié, notifications, newsletter) ---
# Vide = aucun email envoyé ; les liens de réinitialisation s'affichent dans les logs du backend
# (docker compose logs backend).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CHOMA TECH
BREVO_NEWSLETTER_LIST_ID=0

# --- Facultatif : connexion Google / Facebook ---
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
